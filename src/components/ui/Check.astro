---
// Okrągły znacznik „OK”: pomarańczowy na jasnym tle, biały na zdjęciu / pomarańczowym.
interface Props { white?: boolean }
const { white = false } = Astro.props;
---
<span class:list={['check', { 'check--white': white }]} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
</span>
