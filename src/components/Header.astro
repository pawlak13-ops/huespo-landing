---
import Icon from './ui/Icon.astro';
import { LANGS, LANG_LABELS, type Lang } from '../i18n';
import type { Content } from '../i18n/pl';
import { LANG_PATHS } from '../config/seo';
import { LINKS } from '../config/links';

interface Props { c: Content; lang: Lang; transparent?: boolean }
const { c, lang, transparent = false } = Astro.props;
const home = LANG_PATHS[lang];
---
<header class:list={['site-header', { 'is-transparent': transparent }]} id="site-header" data-transparent={transparent ? 'true' : undefined}>
  <div class="container header-inner">
    <a class="logo" href={home} aria-label="Huespo – strona główna">
      <img class="logo-color" src="/logo-wordmark.svg" alt="Huespo" width="150" height="41" />
      <img class="logo-white" src="/logo-wordmark-white.svg" alt="" width="150" height="41" aria-hidden="true" />
    </a>

    <nav class="main-nav" id="main-nav" aria-label={c.nav.mainLabel}>
      <a href={`${home}#jak-to-dziala`}>{c.nav.how}</a>
      <a href={`${home}#funkcje`}>{c.nav.features}</a>
      <a href={`${home}#cennik`}>{c.nav.pricing}</a>
      <a href={`${home}#faq`}>{c.nav.faq}</a>
      <a class="nav-mobile-only" href={LINKS.login}>{c.nav.login}</a>
      <a class="nav-mobile-only nav-cta" href={`${LINKS.register}?lang=${lang}`}>{c.nav.register}</a>
    </nav>

    <div class="auth">
      <a class="auth-login" href={LINKS.login}>{c.nav.login}</a>
      <a class="auth-register" href={`${LINKS.register}?lang=${lang}`}>{c.nav.register}</a>
    </div>

    {LANGS.length > 1 && (
      <ul class="lang-switch" aria-label={c.nav.languages}>
        {LANGS.map((l) => (
          <li>
            <a href={LANG_PATHS[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_LABELS[l]}</a>
          </li>
        ))}
      </ul>
    )}

    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-nav"
      data-open={c.nav.menuOpen}
      data-close={c.nav.menuClose}
      aria-label={c.nav.menuOpen}
    >
      <Icon name="menu" size={24} />
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background: rgba(255, 247, 233, 0.92);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    color: var(--orange-text);
    transition: background-color .25s ease, color .25s ease, box-shadow .25s ease;
  }
  /* Nad zdjęciem w hero: przezroczysty, białe logo i linki */
  .site-header.is-transparent:not(.is-scrolled):not(.menu-open) {
    background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; color: var(--white);
  }
  .header-inner {
    display: flex; align-items: center; gap: 24px; min-height: var(--header-h);
    border-bottom: 1px solid var(--orange-2);
  }
  .site-header.is-transparent:not(.is-scrolled):not(.menu-open) .header-inner { border-bottom-color: var(--white); }

  .logo { flex: none; display: block; position: relative; }
  .logo img { height: 38px; width: auto; }
  .logo-white { position: absolute; inset: 0; opacity: 0; transition: opacity .25s ease; }
  .logo-color { transition: opacity .25s ease; }
  .site-header.is-transparent:not(.is-scrolled):not(.menu-open) .logo-white { opacity: 1; }
  .site-header.is-transparent:not(.is-scrolled):not(.menu-open) .logo-color { opacity: 0; }

  .main-nav { display: flex; gap: clamp(18px, 2.4vw, 36px); margin-left: auto; }
  .main-nav a {
    white-space: nowrap; text-decoration: none; color: inherit; font-size: 15px;
    padding: 6px 0; border-bottom: 1.5px solid transparent; transition: border-color .15s;
  }
  .main-nav a:hover { border-bottom-color: currentColor; }
  .nav-mobile-only { display: none; }

  .auth { display: flex; align-items: center; gap: 8px; margin-left: clamp(8px, 1.5vw, 20px); }
  .auth a {
    display: inline-flex; align-items: center; min-height: 34px; padding: 6px 14px; border-radius: var(--radius-pill);
    font-family: var(--font-display); font-size: 13px; text-decoration: none; white-space: nowrap;
    color: var(--orange-text); border: 1px solid transparent;
    transition: background-color .15s, border-color .15s, filter .15s;
  }
  .auth .auth-login { background: var(--cream); border-color: var(--orange-2); }
  .auth .auth-register { background: var(--orange-1); border-color: var(--orange-1); color: var(--white); }
  .auth a:hover { filter: brightness(0.96); }
  /* Nad zdjęciem w hero ramka niepotrzebna — krem odcina się od pomarańczu */
  .site-header.is-transparent:not(.is-scrolled):not(.menu-open) .auth .auth-login { border-color: var(--cream); }

  .lang-switch { list-style: none; display: flex; gap: 2px; padding: 0; margin: 0; }
  .lang-switch a {
    display: grid; place-items: center; min-width: 36px; min-height: 36px; border-radius: var(--radius-pill);
    font-family: var(--font-display); font-size: 13px; text-decoration: none; color: inherit; opacity: .75;
  }
  .lang-switch a[aria-current='true'] { opacity: 1; box-shadow: inset 0 0 0 1px currentColor; }

  .menu-toggle {
    display: none; margin-left: auto; background: none; color: inherit;
    border: 1px solid currentColor; border-radius: 12px;
    width: 44px; height: 44px; place-items: center; cursor: pointer;
  }

  @media (max-width: 1040px) {
    .auth-login { display: none; }
    .auth { margin-left: auto; }
    .auth + .menu-toggle { margin-left: 0; }
    .menu-toggle { display: grid; }
    .lang-switch { margin-left: auto; }
    .lang-switch + .menu-toggle { margin-left: 0; }
    .main-nav { display: none; }
    .main-nav.is-open {
      display: flex; flex-direction: column; gap: 0;
      position: absolute; top: 100%; left: 0; right: 0; margin: 0;
      background: var(--cream); box-shadow: var(--shadow-lift);
      padding: 6px var(--gutter) 22px;
    }
    .main-nav.is-open a { padding: 15px 0; font-size: 17px; color: var(--orange-text); border-bottom: 1px solid var(--beige); }
    .main-nav.is-open .nav-cta {
      margin-top: 16px; border: 0; border-radius: var(--radius-pill); background: var(--orange-1); color: var(--white);
      text-align: center; font-family: var(--font-display);
    }
    .nav-mobile-only { display: block; }
  }
  @media (max-width: 560px) { .auth { display: none; } .menu-toggle { margin-left: auto !important; } }
  @media (max-width: 480px) { .logo img { height: 32px; } }
</style>
