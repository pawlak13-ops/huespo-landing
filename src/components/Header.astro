---
import Icon from './ui/Icon.astro';
import { LANGS, LANG_LABELS, type Lang } from '../i18n';
import type { Content } from '../i18n/pl';
import { LANG_PATHS } from '../config/seo';
import { LINKS } from '../config/links';

interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const home = LANG_PATHS[lang];
---
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="logo" href={home} aria-label="Huespo">
      <img src="/logo-wordmark.svg" alt="Huespo" width="172" height="47" />
    </a>

    <nav class="main-nav" id="main-nav" aria-label={c.nav.pricing}>
      <a href={`${home}#jak-to-dziala`}>{c.nav.how}</a>
      <a href={`${home}#funkcje`}>{c.nav.features}</a>
      <a href={`${home}#cennik`}>{c.nav.pricing}</a>
      <a href={`${home}#faq`}>{c.nav.faq}</a>
      <a class="nav-login-mobile" href={LINKS.login}>{c.nav.login}</a>
    </nav>

    <div class="header-actions">
      {LANGS.length > 1 && (
        <ul class="lang-switch" aria-label={c.nav.languages}>
          {LANGS.map((l) => (
            <li>
              <a href={LANG_PATHS[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
                {LANG_LABELS[l]}
              </a>
            </li>
          ))}
        </ul>
      )}
      <a class="btn btn--outline btn--sm header-login" href={LINKS.login}>{c.nav.login}</a>
      <a class="btn btn--primary btn--sm header-cta" href={`${home}#cennik`}>{c.nav.cta}</a>
      <button
        class="menu-toggle"
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="main-nav"
        data-open={c.nav.menuOpen}
        data-close={c.nav.menuClose}
        aria-label={c.nav.menuOpen}
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50;
    background: rgba(255, 252, 243, 0.86);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color .2s ease;
  }
  :global(.site-header.is-scrolled) { border-bottom-color: var(--brand-border); }
  .header-inner { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .logo { flex: none; display: block; }
  .logo img { height: 42px; width: auto; }
  .main-nav { display: flex; gap: 28px; margin-left: 12px; }
  .main-nav a { white-space: nowrap; text-decoration: none; color: var(--text-muted); font-size: 15px; transition: color .15s; }
  .main-nav a:hover { color: var(--text-heading); }
  .nav-login-mobile { display: none; }
  .header-actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .header-actions .btn { white-space: nowrap; }
  .lang-switch { list-style: none; display: flex; gap: 2px; padding: 0; margin: 0 6px 0 0; }
  .lang-switch a {
    display: grid; place-items: center; min-width: 36px; min-height: 36px; border-radius: 100px;
    font-family: var(--font-display); font-size: 13px; text-decoration: none; color: var(--text-muted);
  }
  .lang-switch a[aria-current='true'] { color: var(--text-heading); box-shadow: inset 0 0 0 1px var(--brand-border); }
  .menu-toggle {
    display: none; background: none; border: 1px solid var(--brand-border); border-radius: var(--radius-btn);
    width: 44px; height: 44px; place-items: center; cursor: pointer; color: var(--text-heading);
  }

  @media (max-width: 1120px) {
    .main-nav { display: none; }
    .header-login { display: none; }
    .menu-toggle { display: grid; }
    .main-nav.is-open {
      display: flex; flex-direction: column; gap: 0;
      position: absolute; top: 100%; left: 0; right: 0; margin: 0;
      background: var(--brand-cream); border-bottom: 1px solid var(--brand-border);
      padding: 8px var(--gutter) 20px;
    }
    .main-nav.is-open a { padding: 14px 0; font-size: 17px; color: var(--text-heading); border-bottom: 1px solid var(--brand-beige); }
    .nav-login-mobile { display: block; }
  }
  @media (max-width: 560px) {
    .header-cta { display: none; }
    .logo img { height: 36px; }
    .header-inner { gap: 12px; }
  }
</style>
