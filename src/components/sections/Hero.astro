---
import { Picture } from 'astro:assets';
import bg from '../../assets/bg-streaks.jpg';
import guest from '../../assets/hero-guest.jpg';
import type { Content } from '../../i18n/pl';
import { LINKS } from '../../config/links';

interface Props { c: Content }
const { c } = Astro.props;
const h = c.hero;
---
<section class="hero on-orange" aria-labelledby="hero-title">
  <div class="hero-bg fill-picture" aria-hidden="true">
    <Picture src={bg} formats={['avif', 'webp']} widths={[768, 1366]} sizes="100vw" alt="" loading="eager" fetchpriority="high" />
  </div>

  <div class="hero-photo" aria-hidden="false">
    <Picture
      src={guest}
      formats={['avif', 'webp']}
      widths={[480, 911]}
      sizes="(max-width: 820px) 100vw, 60vw"
      alt={h.imageAlt}
      loading="eager"
    />
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">
        <span class="eyebrow">{h.eyebrow}</span>
        <span class="hero-title">{h.title}</span>
      </h1>
      <p class="hero-sub">{h.sub}</p>
      <div class="hero-ctas">
        <a class="btn btn--cream" href={`${LINKS.register}?lang=pl`}>{h.ctaPrimary} <small>{h.ctaPrimarySmall}</small></a>
        <a class="btn btn--ghost" href={LINKS.login}>{h.ctaSecondary} <small>– {h.ctaSecondarySmall}</small></a>
      </div>
    </div>

    <p class="platforms">
      <span>{h.platformsLabel}</span>
      {h.platforms.map((p) => <strong>{p}</strong>)}
    </p>
  </div>
  <div class="blend blend--bottom" style="--blend: var(--cream)" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; color: var(--white);
    background: var(--orange-1);
    padding: calc(var(--header-h) + clamp(40px, 6vw, 72px)) 0 clamp(96px, 10vw, 150px);
    min-height: min(820px, 100svh);
    display: flex;
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg :global(img) { object-position: 60% 50%; }
  /* Delikatne przyciemnienie za tekstem, żeby biały tekst był czytelny */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(70% 80% at 18% 52%, rgba(214, 72, 0, 0.42), transparent 70%),
      linear-gradient(180deg, rgba(200, 70, 0, 0.18), transparent 30%, transparent 75%, rgba(200, 70, 0, 0.25));
  }

  .hero-photo {
    position: absolute; z-index: 1; top: 0; bottom: 0; right: 0; width: 58%;
    -webkit-mask-image: radial-gradient(85% 95% at 68% 50%, #000 52%, transparent 78%);
            mask-image: radial-gradient(85% 95% at 68% 50%, #000 52%, transparent 78%);
  }
  .hero-photo :global(picture), .hero-photo :global(img) { display: block; width: 100%; height: 100%; }
  .hero-photo :global(img) { object-fit: cover; object-position: 55% 35%; }

  .hero-inner { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; gap: 48px; }
  .hero-copy { max-width: 600px; }
  .hero-sub { max-width: 34em; }
  h1 { color: var(--white); }
  h1 .eyebrow { margin-bottom: 22px; font-size: 13px; }
  .hero-title {
    display: block; font-weight: 300;
    text-shadow: 0 2px 18px rgba(150, 50, 0, 0.25);
  }
  .hero-sub { margin-top: 20px; max-width: 32em; font-size: 17px; text-shadow: 0 1px 10px rgba(150, 50, 0, 0.35); }
  .hero-ctas { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin-top: 36px; }
  .hero-ctas .btn { min-width: 300px; }

  .platforms {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 8px 22px;
    font-size: 14px; text-shadow: 0 1px 8px rgba(150, 50, 0, 0.35);
  }
  .platforms strong { font-family: var(--font-display); font-weight: 400; font-size: 15px; }

  @media (max-width: 820px) {
    .hero { min-height: 0; padding-top: 0; }
    .hero-photo {
      position: relative; width: auto; height: calc(var(--header-h) + 270px); order: -1;
      margin: 0 0 -70px;
      -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
              mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    }
    .hero { flex-direction: column; }
    .hero-inner { margin-top: 0; }
    .hero::before { background: linear-gradient(180deg, transparent 20%, rgba(214, 72, 0, 0.35) 55%, rgba(200, 70, 0, 0.25)); }
    .hero-ctas, .hero-ctas .btn { width: 100%; min-width: 0; }
    .platforms { justify-content: flex-start; font-size: 14px; gap: 6px 16px; }
    .platforms span { flex-basis: 100%; }
  }
</style>
