---
import { Picture } from 'astro:assets';
import handPhone from '../../assets/cta-hand-phone.jpg';
import screen from '../../assets/guest-page-screenshot.jpg';
import type { Content } from '../../i18n/pl';
interface Props { c: Content }
const { c } = Astro.props;
const t = c.cta;
---
<section class="cta on-orange" aria-labelledby="cta-title">
  <div class="container cta-grid">
    <div class="cta-copy">
      <h2 id="cta-title">{t.title}</h2>
      <p class="cta-sub">{t.sub}</p>
      <a class="btn btn--ghost cta-btn" href="#cennik">{t.button}</a>
    </div>

    <figure class="cta-visual">
      <Picture
        src={handPhone}
        formats={['avif', 'webp']}
        widths={[400, 670]}
        sizes="(max-width: 820px) 80vw, 460px"
        alt={t.imageAlt}
        loading="lazy"
        class="cta-hand"
      />
      <div class="cta-screen" aria-hidden="true">
        <Picture src={screen} formats={['avif', 'webp']} widths={[240, 480]} sizes="150px" alt="" loading="lazy" />
      </div>
    </figure>
  </div>
</section>

<style>
  /* Tło dopasowane do koloru zdjęcia z dłonią, żeby łączenie było niewidoczne */
  .cta {
    position: relative; overflow: hidden; color: var(--white);
    background: linear-gradient(100deg, #f26a1b 0%, #ff7a2a 45%, #ff8931 100%);
    padding-top: clamp(56px, 7vw, 88px);
  }
  .cta-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 32px; align-items: end; }
  .cta-copy { align-self: center; padding-bottom: clamp(56px, 7vw, 88px); }
  h2 { color: var(--white); max-width: 16em; text-shadow: 0 2px 14px rgba(150, 50, 0, 0.25); }
  .cta-sub { margin-top: 20px; font-size: 16px; }
  .cta-btn { margin-top: 36px; min-width: 300px; }

  .cta-visual { position: relative; margin: 0; justify-self: center; width: min(460px, 100%); }
  .cta-visual :global(img.cta-hand) {
    display: block; width: 100%; height: auto;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14%, #000 86%, transparent 100%), linear-gradient(180deg, transparent 0, #000 10%);
    -webkit-mask-composite: source-in;
            mask-image: linear-gradient(90deg, transparent 0, #000 14%, #000 86%, transparent 100%), linear-gradient(180deg, transparent 0, #000 10%);
            mask-composite: intersect;
  }
  /* Prawdziwy zrzut przewodnika w miejscu czarnego ekranu na zdjęciu */
  .cta-screen {
    position: absolute; left: 18.6%; top: 11.5%; width: 31.4%; height: 46.6%;
    border-radius: 3px; overflow: hidden; background: var(--cream);
  }
  .cta-screen :global(picture), .cta-screen :global(img) { display: block; width: 100%; height: 100%; }
  .cta-screen :global(img) { object-fit: cover; object-position: top; }

  @media (max-width: 820px) {
    .cta-grid { grid-template-columns: 1fr; }
    .cta-copy { padding-bottom: 8px; }
    .cta-btn { width: 100%; min-width: 0; }
    .cta-visual { width: min(360px, 90%); }
  }
</style>
