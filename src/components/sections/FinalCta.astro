---
import { Picture } from 'astro:assets';
import ctaBg from '../../assets/cta-light.jpg';
import type { Content } from '../../i18n/pl';
interface Props { c: Content }
const { c } = Astro.props;
---
<section class="final" aria-labelledby="final-title">
  <div class="container">
    <div class="final-band">
      <div class="final-bg fill-picture" aria-hidden="true">
        <Picture src={ctaBg} formats={['avif', 'webp']} widths={[800, 1366]} sizes="100vw" alt="" loading="lazy" />
      </div>
      <div class="final-inner">
        <h2 id="final-title">{c.finalCta.title}</h2>
        <a class="btn btn--white" href="#cennik">{c.finalCta.button}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .final { padding: 0 0 var(--section-y); background: var(--brand-beige); }
  .final-band {
    position: relative; overflow: hidden; border-radius: var(--radius-frame);
    background: var(--brand-orange); border: 1px solid var(--brand-border); box-shadow: var(--shadow-card);
  }
  .final-bg { position: absolute; inset: 0; }
  .final-bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .final-bg::after { content: ''; position: absolute; inset: 0; background: rgba(255, 97, 5, 0.55); }
  .final-inner {
    position: relative; padding: clamp(48px, 7vw, 88px) clamp(24px, 6vw, 80px);
    display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap;
  }
  h2 { color: var(--white); max-width: 18ch; font-size: clamp(28px, 3.6vw, 46px); }
</style>
