---
import { Picture } from 'astro:assets';
import bg from '../../assets/bg-streaks.jpg';
import type { Content } from '../../i18n/pl';
interface Props { c: Content }
const { c } = Astro.props;
const h = c.how;
---
<section class="section how on-orange" id="jak-to-dziala" aria-labelledby="how-title">
  <div class="how-bg fill-picture" aria-hidden="true">
    <Picture src={bg} formats={['avif', 'webp']} widths={[768, 1366]} sizes="100vw" alt="" loading="lazy" />
  </div>

  <div class="container how-inner">
    <div class="how-head">
      <p class="eyebrow">{h.eyebrow}</p>
      <h2 id="how-title">
        <span class="big-number">{h.bigNumber}</span>
        <span class="how-title-text">
          {h.titleAfterNumber}
          <span class="line2">{h.titleLine2}</span>
        </span>
      </h2>
      <p class="how-sub">{h.sub}</p>
    </div>

    <ol class="steps" role="list">
      {h.steps.map((s, i) => (
        <li class="step reveal">
          <h3><span class="step-n" aria-hidden="true">{i + 1}.</span> {s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how { overflow: hidden; color: var(--white); background: var(--orange-1); }
  .how-bg { position: absolute; inset: 0; }
  .how-bg :global(img) { object-position: 70% 60%; filter: saturate(1.3); }
  .how::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(70% 70% at 70% 30%, rgba(214, 72, 0, 0.35), transparent 75%),
      linear-gradient(90deg, rgba(255, 114, 30, 0.45), rgba(255, 114, 30, 0.2) 50%, rgba(255, 114, 30, 0.5));
  }
  .how-inner { position: relative; z-index: 2; }

  .how-head { display: grid; justify-items: end; text-align: right; }
  .eyebrow { margin-bottom: 14px; }
  h2 { color: var(--white); display: flex; align-items: center; justify-content: flex-end; gap: clamp(16px, 3vw, 40px); }
  .big-number {
    font-family: var(--font-display); font-weight: 400; line-height: .8; letter-spacing: -0.05em;
    font-size: clamp(96px, 11vw, 160px); color: var(--white);
    text-shadow: 0 10px 40px rgba(150, 50, 0, 0.25);
  }
  .how-title-text { display: block; max-width: 15em; text-shadow: 0 2px 14px rgba(150, 50, 0, 0.3); }
  .line2 { display: block; }
  .how-sub { margin-top: 18px; font-size: 15.5px; text-shadow: 0 1px 8px rgba(150, 50, 0, 0.35); }

  .steps { list-style: none; padding: 0; margin: clamp(40px, 5vw, 64px) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .step {
    background: var(--cream); border: 1.5px solid var(--orange-2); border-radius: var(--radius-card);
    padding: 22px 22px 24px; box-shadow: var(--shadow-lift); color: var(--orange-text);
  }
  h3 { display: flex; align-items: baseline; gap: 10px; color: var(--orange-heading); }
  .step-n { font-family: var(--font-display); font-size: 28px; font-weight: 400; line-height: 1; }
  .step p { margin-top: 12px; font-size: 15px; line-height: 1.55; }

  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .how-head { justify-items: start; text-align: left; }
    h2 { justify-content: flex-start; }
    .big-number { font-size: 96px; }
  }
</style>
