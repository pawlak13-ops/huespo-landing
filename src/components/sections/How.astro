---
import type { Content } from '../../i18n/pl';
interface Props { c: Content }
const { c } = Astro.props;
---
<section class="section" id="jak-to-dziala" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head">
      <h2 id="how-title">{c.how.title}</h2>
    </div>
    <ol class="steps" role="list">
      {c.how.steps.map((s, i) => (
        <li class="step reveal">
          <span class="step-num display" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 4vw, 48px); counter-reset: step; }
  .step { position: relative; padding-top: 28px; border-top: 1px solid var(--brand-border); }
  .step-num {
    position: absolute; top: -21px; left: 0;
    width: 42px; height: 42px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--brand-cream); border: 1px solid var(--brand-border);
    font-size: 19px; color: var(--accent-text);
  }
  .step h3 { margin-top: 14px; }
  .step p { margin-top: 10px; color: var(--text-muted); }
  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; gap: 44px; }
  }
</style>
