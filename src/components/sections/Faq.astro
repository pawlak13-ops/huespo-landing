---
import { Picture } from 'astro:assets';
import glass from '../../assets/bg-glass.jpg';
import Icon from '../ui/Icon.astro';
import type { Content } from '../../i18n/pl';
interface Props { c: Content }
const { c } = Astro.props;
---
<section class="faq on-orange" id="faq" aria-labelledby="faq-title">
  <div class="faq-grid">
    <div class="glass-card">
      <div class="fill-picture glass-bg" aria-hidden="true">
        <Picture src={glass} formats={["avif", "webp"]} quality={80} widths={[700, 1366]} sizes="(max-width: 820px) 100vw, 50vw" alt="" loading="lazy" />
      </div>
      <h2 id="faq-title">{c.faq.title}</h2>
    </div>

    <div class="faq-list">
      {c.faq.items.map((item) => (
        <details>
          <summary>
            <span>{item.q}</span>
            <Icon name="chevron" size={20} class="chev" />
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
  <div class="blend blend--top" style="--blend: var(--cream); height: 56px" aria-hidden="true"></div>
</section>

<style>
  .faq { position: relative; background: var(--orange-1); color: var(--white); }
  .faq-grid { position: relative; z-index: 2; }
  .faq-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: stretch; }

  .glass-card {
    position: relative; overflow: hidden; min-height: 420px;
    border-radius: 0 var(--radius-big) var(--radius-big) 0;
    padding: clamp(32px, 5vw, 64px) clamp(24px, 4vw, 56px) clamp(32px, 5vw, 64px) max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
  }
  .glass-bg { position: absolute; inset: 0; }
  .glass-bg :global(img) { object-position: 72% 55%; }
  .glass-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(160deg, rgba(220, 80, 0, 0.35), transparent 60%); }
  h2 { position: relative; z-index: 1; color: var(--white); max-width: 10em; text-shadow: 0 2px 14px rgba(150, 50, 0, 0.3); }

  .faq-list { padding: clamp(60px, 6vw, 80px) var(--gutter) clamp(32px, 5vw, 64px) 0; max-width: 620px; }
  details { border-bottom: 1px solid var(--line-white); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 16px 0; font-family: var(--font-display); font-weight: 300; font-size: 16px; line-height: 1.35;
  }
  summary::-webkit-details-marker { display: none; }
  summary :global(.chev) { flex: none; transition: transform .2s ease; }
  details[open] summary :global(.chev) { transform: rotate(180deg); }
  details p { padding: 0 32px 18px 0; font-size: 14.5px; line-height: 1.6; }

  @media (max-width: 820px) {
    .faq-grid { grid-template-columns: 1fr; gap: 0; }
    .glass-card { min-height: 220px; border-radius: 0 0 var(--radius-big) var(--radius-big); display: flex; align-items: flex-end; }
    .glass-card h2 { margin: 0; }
    .faq-list { padding: 24px var(--gutter) 48px; max-width: none; }
  }
</style>
