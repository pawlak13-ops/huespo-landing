---
import Icon from '../ui/Icon.astro';
import type { Content } from '../../i18n/pl';
interface Props { c: Content }
const { c } = Astro.props;
const f = c.features;
---
<section class="section features" id="funkcje" aria-labelledby="features-title">
  <div class="container">
    <p class="eyebrow">{f.eyebrow}</p>
    <h2 id="features-title">
      <img class="wordmark" src="/logo-text-orange.svg" alt="Huespo" width="300" height="62" />
      <span class="features-title">{f.title}</span>
    </h2>

    <ul class="bento" role="list">
      <li class="card card--lead reveal">
        <Icon name={f.lead.icon} size={26} class="card-icon" />
        <h3>{f.lead.title}</h3>
        <p>{f.lead.text}</p>
      </li>
      {f.items.map((it) => (
        <li class="card reveal">
          <Icon name={it.icon} size={26} class="card-icon" />
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .features { background: var(--beige); }
  .eyebrow { color: var(--orange-text-beige); margin-bottom: 18px; }
  h2 { color: var(--orange-heading-beige); }
  .wordmark { width: clamp(130px, 13vw, 180px); height: auto; margin-bottom: 12px; }
  .features-title { display: block; max-width: 20em; }

  .bento { list-style: none; padding: 0; margin: clamp(32px, 4vw, 48px) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .card {
    position: relative; background: var(--cream); border: 1.5px solid var(--orange-2); border-radius: var(--radius-card);
    padding: 24px 24px 26px; color: var(--orange-text); min-height: 150px;
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .card :global(.card-icon) { position: absolute; top: 18px; right: 18px; color: var(--orange-2); }
  h3 { color: var(--orange-heading); padding-right: 36px; }
  .card p { margin-top: 8px; font-size: 14px; line-height: 1.55; }

  .card--lead { grid-column: span 2; background: var(--orange-1); border-color: var(--orange-1); color: var(--white); }
  .card--lead h3 { color: var(--white); }
  .card--lead p { font-size: 15px; max-width: 36em; }
  .card--lead :global(.card-icon) { color: var(--white); }

  @media (max-width: 900px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .bento { grid-template-columns: 1fr; }
    .card--lead { grid-column: auto; }
  }
</style>
