---
import { Picture } from 'astro:assets';
import glass from '../../assets/bg-glass.jpg';
import type { Content } from '../../i18n/pl';
import type { Lang } from '../../i18n';
import { THANKS_PATHS } from '../../config/seo';
import { LINKS } from '../../config/links';

interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const f = c.form;
---
<section class="contact on-orange" id="kontakt" aria-labelledby="form-title">
  <div class="contact-grid">
    <form
      class="contact-form"
      name="kontakt"
      method="POST"
      action={THANKS_PATHS[lang]}
      data-netlify="true"
      netlify-honeypot="bot-field"
      novalidate
      data-msg-required={f.errorRequired}
      data-msg-email={f.errorEmail}
      data-msg-privacy={f.errorPrivacy}
      data-msg-sending={f.sending}
      data-msg-success={f.success}
      data-msg-error={f.error}
    >
      <input type="hidden" name="form-name" value="kontakt" />
      <input type="hidden" name="language" value={lang} />
      <p class="visually-hidden" aria-hidden="true">
        <label>Nie wypełniaj: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="field">
        <label for={`f-name-${lang}`}>{f.name}</label>
        <input id={`f-name-${lang}`} name="name" type="text" autocomplete="name" required />
        <p class="field-error" aria-live="polite"></p>
      </div>
      <div class="field">
        <label for={`f-email-${lang}`}>{f.email}</label>
        <input id={`f-email-${lang}`} name="email" type="email" autocomplete="email" inputmode="email" required />
        <p class="field-error" aria-live="polite"></p>
      </div>
      <div class="field">
        <label for={`f-phone-${lang}`}>{f.phone} <span class="opt">({f.optional})</span></label>
        <input id={`f-phone-${lang}`} name="phone" type="tel" autocomplete="tel" inputmode="tel" />
      </div>
      <div class="field">
        <label for={`f-msg-${lang}`}>{f.message}</label>
        <textarea id={`f-msg-${lang}`} name="message" rows="4" required></textarea>
        <p class="field-error" aria-live="polite"></p>
      </div>

      <div class="field field--check">
        <input id={`f-privacy-${lang}`} name="privacy" type="checkbox" value="yes" required />
        <label for={`f-privacy-${lang}`}>
          {f.privacyBefore}<a href={LINKS.privacy} target="_blank" rel="noopener">{f.privacyLink}</a>{f.privacyAfter}
        </label>
        <p class="field-error" aria-live="polite"></p>
      </div>

      <button class="btn btn--cream submit" type="submit">{f.submit}</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>

    <div class="glass-card">
      <div class="fill-picture glass-bg" aria-hidden="true">
        <Picture src={glass} formats={["avif", "webp"]} quality={80} widths={[700, 1366]} sizes="(max-width: 820px) 100vw, 50vw" alt="" loading="lazy" />
      </div>
      <div class="glass-copy">
        <h2 id="form-title">{f.title}</h2>
        <p>{f.text}</p>
        <p><a href={`mailto:${LINKS.email}`}>{LINKS.email}</a></p>
      </div>
    </div>
  </div>
  <div class="blend blend--bottom" style="--blend: var(--cream)" aria-hidden="true"></div>
</section>

<style>
  .contact { position: relative; background: var(--orange-1); color: var(--white); }
  .contact-grid { position: relative; z-index: 2; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: stretch; }

  .contact-form {
    display: grid; gap: 18px; align-content: start; width: 100%;
    padding: clamp(48px, 6vw, 80px) 0 clamp(48px, 6vw, 80px) max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
  }
  .field { display: grid; gap: 6px; }
  label { font-size: 14px; }
  .opt { opacity: .8; font-size: 13px; }
  input[type='text'], input[type='email'], input[type='tel'], textarea {
    width: 100%; min-height: 48px; padding: 11px 16px;
    background: rgba(255, 255, 255, 0.08); border: 1.5px solid rgba(255, 255, 255, 0.75); border-radius: 14px;
    font-size: 16px; color: var(--white);
  }
  textarea { resize: vertical; min-height: 110px; }
  input:focus, textarea:focus { outline: 2px solid var(--white); outline-offset: 2px; background: rgba(255, 255, 255, 0.14); }
  [aria-invalid='true'] { border-color: #fff3a8; }
  .field-error { font-size: 13.5px; color: #fff3a8; font-weight: 500; }
  .field-error:empty { display: none; }

  .field--check { grid-template-columns: auto 1fr; align-items: start; column-gap: 10px; }
  .field--check input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--cream); }
  .field--check label { font-size: 14px; }
  .field--check label a { color: var(--white); }
  .field--check .field-error { grid-column: 2; }

  .submit { justify-self: center; min-width: 260px; margin-top: 6px; }
  .submit[disabled] { opacity: .7; cursor: progress; }
  .form-status { font-size: 15px; text-align: center; font-weight: 500; }
  .form-status:empty { display: none; }

  .glass-card { position: relative; overflow: hidden; border-radius: var(--radius-big) 0 0 var(--radius-big); margin: clamp(24px, 3vw, 40px) 0; }
  .glass-bg { position: absolute; inset: 0; }
  .glass-bg :global(img) { object-position: 70% 50%; }
  .glass-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(200deg, rgba(220, 80, 0, 0.3), transparent 60%); }
  .glass-copy {
    position: relative; z-index: 1; max-width: 520px;
    padding: clamp(40px, 5vw, 64px) var(--gutter) 40px clamp(28px, 4vw, 48px);
  }
  h2 { color: var(--white); text-shadow: 0 2px 14px rgba(150, 50, 0, 0.3); }
  .glass-copy p { margin-top: 16px; font-size: 15px; text-shadow: 0 1px 8px rgba(150, 50, 0, 0.35); }
  .glass-copy a { color: var(--white); text-underline-offset: 4px; }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; gap: 0; }
    .glass-card { order: -1; border-radius: 0 0 var(--radius-big) var(--radius-big); margin: 0; }
    .contact-form { padding: 32px var(--gutter) 56px; }
    .submit { width: 100%; min-width: 0; }
  }
</style>
