---
import type { Content } from '../../i18n/pl';
import type { Lang } from '../../i18n';
import { THANKS_PATHS } from '../../config/seo';
import { LINKS } from '../../config/links';

interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const f = c.form;
---
<section class="section section--beige" id="kontakt" aria-labelledby="form-title">
  <div class="container form-grid">
    <div>
      <h2 id="form-title">{f.title}</h2>
      <p class="form-intro">{f.text}</p>
      <p class="form-mail"><a href={`mailto:${LINKS.email}`}>{LINKS.email}</a></p>
    </div>

    <form
      class="card-form"
      name="kontakt"
      method="POST"
      action={THANKS_PATHS[lang]}
      data-netlify="true"
      netlify-honeypot="bot-field"
      novalidate
      data-msg-required={f.errorRequired}
      data-msg-email={f.errorEmail}
      data-msg-privacy={f.errorPrivacy}
      data-msg-sending={f.sending}
      data-msg-success={f.success}
      data-msg-error={f.error}
    >
      <input type="hidden" name="form-name" value="kontakt" />
      <input type="hidden" name="language" value={lang} />
      <p class="visually-hidden" aria-hidden="true">
        <label>Nie wypełniaj: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="row-2">
        <div class="field">
          <label for={`f-name-${lang}`}>{f.name}</label>
          <input id={`f-name-${lang}`} name="name" type="text" autocomplete="given-name" required />
          <p class="field-error" aria-live="polite"></p>
        </div>
        <div class="field">
          <label for={`f-email-${lang}`}>{f.email}</label>
          <input id={`f-email-${lang}`} name="email" type="email" autocomplete="email" inputmode="email" required />
          <p class="field-error" aria-live="polite"></p>
        </div>
      </div>

      <div class="field">
        <label for={`f-props-${lang}`}>{f.properties}</label>
        <select id={`f-props-${lang}`} name="properties" required>
          <option value="" disabled selected>{f.propertiesPlaceholder}</option>
          {f.propertiesOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
        <p class="field-error" aria-live="polite"></p>
      </div>

      <div class="field">
        <label for={`f-msg-${lang}`}>{f.message} <span class="opt">({f.optional})</span></label>
        <textarea id={`f-msg-${lang}`} name="message" rows="4"></textarea>
      </div>

      <div class="field field--check">
        <input id={`f-privacy-${lang}`} name="privacy" type="checkbox" value="yes" required />
        <label for={`f-privacy-${lang}`}>
          {f.privacyBefore}<a href={`${LINKS.privacy}?lang=${lang}`} target="_blank" rel="noopener">{f.privacyLink}</a>{f.privacyAfter}
        </label>
        <p class="field-error" aria-live="polite"></p>
      </div>

      <div class="field field--check">
        <input id={`f-news-${lang}`} name="newsletter" type="checkbox" value="yes" />
        <label for={`f-news-${lang}`}>{f.newsletter} <span class="opt">({f.optional})</span></label>
      </div>

      <button class="btn btn--primary submit" type="submit">{f.submit}</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .form-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .form-intro { margin-top: 18px; color: var(--text-body); max-width: 28em; }
  .form-mail { margin-top: 18px; }
  .form-mail a { color: var(--text-heading); text-decoration-color: var(--brand-orange); text-underline-offset: 4px; }

  .card-form {
    background: var(--white); border: 1px solid var(--brand-border); border-radius: var(--radius-card);
    box-shadow: var(--shadow-card); padding: clamp(22px, 3vw, 32px); display: grid; gap: 18px;
  }
  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { display: grid; gap: 6px; }
  label { font-size: 14.5px; color: var(--text-heading); }
  .opt { color: var(--text-muted); font-size: 13px; }
  input[type='text'], input[type='email'], select, textarea {
    width: 100%; min-height: 48px; padding: 11px 14px;
    background: var(--brand-cream); border: 1px solid var(--brand-border); border-radius: var(--radius-btn);
    font-size: 16px; color: var(--text-heading);
  }
  textarea { resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--brand-orange); outline-offset: 1px; border-color: var(--brand-orange); }
  [aria-invalid='true'] { border-color: #c4320a; }
  .field-error { font-size: 13px; color: #b42d08; min-height: 0; }
  .field-error:empty { display: none; }

  .field--check { grid-template-columns: auto 1fr; align-items: start; column-gap: 10px; }
  .field--check input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--brand-orange); }
  .field--check label { font-size: 14px; color: var(--text-body); }
  .field--check label a { color: var(--text-heading); }
  .field--check .field-error { grid-column: 2; }

  .submit { justify-self: start; min-width: 200px; }
  .submit[disabled] { opacity: .65; cursor: progress; }
  .form-status { font-size: 15px; }
  .form-status:empty { display: none; }
  .form-status.ok { color: #1f7a45; }
  .form-status.err { color: #b42d08; }

  @media (max-width: 860px) { .form-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .row-2 { grid-template-columns: 1fr; } .submit { width: 100%; } }
</style>
