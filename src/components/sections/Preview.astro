---
import { Picture } from 'astro:assets';
import guestScreenshot from '../../assets/guest-page-screenshot.jpg';
import type { Content } from '../../i18n/pl';
interface Props { c: Content }
const { c } = Astro.props;
const p = c.preview;
---
<section class="section" aria-labelledby="preview-title">
  <div class="container preview-grid">
    <div class="preview-copy">
      <h2 id="preview-title">{p.title}</h2>
      <p class="muted">{p.text}</p>
      <ul class="preview-tabs-list">
        {p.tabs.map((t) => <li>{t}</li>)}
      </ul>
    </div>

    <figure class="phone reveal">
      <div class="phone-screen">
        <Picture
          src={guestScreenshot}
          formats={['avif', 'webp']}
          widths={[375, 750]}
          sizes="(max-width: 420px) 86vw, 340px"
          alt={p.imageAlt}
          loading="lazy"
        />
      </div>
      <figcaption class="ph-note">{p.note}</figcaption>
    </figure>
  </div>
</section>

<style>
  .preview-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); align-items: center; }
  .preview-copy p { margin-top: 18px; max-width: 30em; }
  .preview-tabs-list { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .preview-tabs-list li { border: 1px solid var(--brand-border); border-radius: 100px; padding: 6px 14px; font-size: 14px; color: var(--text-heading); background: var(--white); }

  .phone { margin: 0 auto; width: min(340px, 100%); min-width: 0; }
  .phone-screen {
    border: 10px solid var(--text-heading); border-radius: 44px; overflow: hidden;
    background: var(--brand-cream); box-shadow: var(--shadow-lift);
    aspect-ratio: 750 / 1300;
  }
  .phone-screen :global(picture), .phone-screen :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .ph-note { text-align: center; margin-top: 14px; font-size: 13px; color: var(--text-muted); }

  @media (max-width: 860px) { .preview-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
