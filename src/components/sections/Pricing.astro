---
import { Picture } from 'astro:assets';
import compactBg from '../../assets/bg-violet.jpg';
import type { Content } from '../../i18n/pl';
import type { Lang } from '../../i18n';
import { PLANS, CURRENCIES, DEFAULT_CURRENCY, priceParts, formatPrice, yearlySaving } from '../../config/pricing';
import { registerUrl } from '../../config/links';

interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const t = c.pricing;
const cur = DEFAULT_CURRENCY[lang];
// Wersja polska ma zawsze złotówki; ES/EN pozwalają wybrać EUR lub GBP.
const lockCurrency = lang === 'pl';
const currencies = lockCurrency ? [cur] : CURRENCIES.filter((cc) => cc !== 'PLN');

// Wszystkie warianty cen trafiają do HTML — przełączniki tylko je podmieniają.
const priceData = (planIdx: number) => {
  const plan = PLANS[planIdx];
  const out: Record<string, unknown> = {};
  for (const cc of CURRENCIES) {
    out[cc] = {
      monthly: priceParts(plan.prices[cc].monthly, cc),
      yearly: priceParts(plan.prices[cc].yearly, cc),
      saving: formatPrice(yearlySaving(plan, cc), cc),
    };
  }
  return JSON.stringify(out);
};
const code = (cc: string) => (cc === 'GBP' ? '£' : cc === 'EUR' ? '€' : 'PLN');
---
<section
  class="section pricing"
  id="cennik"
  aria-labelledby="pricing-title"
  data-default-currency={cur}
  data-lock-currency={lockCurrency ? 'true' : undefined}
  data-lang={lang}
>
  <div class="container">
    <div class="pricing-head">
      <div>
        <h2 id="pricing-title">{t.title}</h2>
        <p class="pricing-sub">{t.sub}</p>
      </div>
      <div class="pricing-controls">
        <div class="pill-group" role="group" aria-label={t.cycleLabel}>
          <button type="button" data-cycle="monthly" aria-pressed="true">{t.monthly}</button>
          <button type="button" data-cycle="yearly" aria-pressed="false">{t.yearly} <span class="hint">· {t.yearlyHint}</span></button>
        </div>
        {currencies.length > 1 && (
          <div class="pill-group" role="group" aria-label={t.currencyLabel}>
            {currencies.map((cc) => (
              <button type="button" data-currency={cc} aria-pressed={cc === cur ? 'true' : 'false'}>{cc}</button>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="plans">
      {PLANS.map((plan, idx) => {
        const p = priceParts(plan.prices[cur].monthly, cur);
        const onDark = plan.variant !== 'light';
        const btnClass = plan.variant === 'light' ? 'btn--orange' : plan.variant === 'photo' ? 'btn--white' : 'btn--beige';
        return (
          <article class:list={['plan', `plan--${plan.variant}`, `plan--${plan.id}`]} aria-labelledby={`plan-${plan.id}`}>
            {plan.variant === 'photo' && (
              <div class="plan-bg fill-picture" aria-hidden="true">
                <Picture src={compactBg} formats={['avif', 'webp']} widths={[400]} alt="" loading="lazy" />
              </div>
            )}
            <div class="plan-inner">
              <div class="plan-top">
                <h3 id={`plan-${plan.id}`}>{plan.name}</h3>
                <div class="plan-price">
                  <p class="price" data-prices={priceData(idx)}>
                    <span class="cur" data-part="code">{code(cur)}</span>
                    <span class="num" data-part="number">{p.number}</span>
                  </p>
                  <p class="per" data-per-month={t.perMonth} data-per-year={t.perYear}>{t.perMonth}</p>
                </div>
              </div>
              <p class="badge">{t.badges[plan.id]}</p>
              <ul class="features" role="list">
                {t.features[plan.id].map((f) => (
                  <li>
                    {'n' in f && f.n
                      ? <span class="f-n">{f.n}</span>
                      : <svg class:list={['tick', { 'tick--white': onDark }]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>}
                    <span>{f.text}</span>
                  </li>
                ))}
              </ul>
              <div class="plan-bottom">
                <p class="saving" data-template={t.saving} hidden></p>
                <p class="live">
                  <svg class:list={['tick', { 'tick--white': onDark }]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                  <span>{t.liveUpdate}</span>
                </p>
                <a
                  class:list={['btn', btnClass, 'plan-cta']}
                  href={registerUrl(plan.id, 'monthly', lang)}
                  data-plan={plan.id}
                >{t.cta}<span class="visually-hidden"> {plan.name}</span></a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <p class="pricing-note">{t.note}</p>
  </div>
</section>

<style>
  .pricing { background: var(--cream); }
  .pricing-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 40px; }
  h2 { color: var(--orange-heading); font-size: clamp(34px, 4vw, 54px); }
  .pricing-sub { margin-top: 14px; color: var(--orange-text); max-width: 36em; }
  .pricing-controls { display: flex; gap: 10px; flex-wrap: wrap; }
  .hint { opacity: 1; }

  .plans { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; align-items: stretch; max-width: 1040px; margin: 0 auto; }
  .plan {
    position: relative; overflow: hidden; display: flex;
    border-radius: var(--radius-card); background: var(--white); color: var(--ink);
    box-shadow: 0 10px 30px rgba(120, 50, 10, 0.16);
  }
  .plan-inner { position: relative; display: flex; flex-direction: column; width: 100%; padding: 22px 18px 18px; }
  .plan-bg { position: absolute; inset: 0; }
  .plan-bg :global(img) { object-position: 30% 50%; }
  .plan-bg::after { content: ''; position: absolute; inset: 0; background: rgba(180, 60, 0, 0.18); }
  .plan--photo, .plan--orange { color: var(--white); }
  .plan--orange { background: var(--orange-1); }

  .plan-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  h3 { font-size: 19px; font-weight: 500; color: var(--ink); }
  .plan--photo h3, .plan--orange h3 { color: var(--white); }
  .plan-price { text-align: right; }
  .price { display: flex; align-items: baseline; justify-content: flex-end; gap: 4px; white-space: nowrap; line-height: 1; color: var(--orange-text); }
  .plan--photo .price, .plan--orange .price { color: var(--white); text-shadow: 0 2px 8px rgba(120, 40, 0, 0.3); }
  .cur { font-family: var(--font-display); font-size: 12px; }
  .num { font-family: var(--font-display); font-weight: 500; font-size: 22px; letter-spacing: -0.02em; }
  .per { font-size: 12px; margin-top: 4px; opacity: .8; }

  .badge {
    margin-top: 16px; padding-bottom: 10px; border-bottom: 1px solid rgba(43, 26, 16, 0.25);
    font-family: var(--font-display); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase;
  }
  .plan--photo .badge, .plan--orange .badge { border-bottom-color: var(--line-white); }

  .features { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 7px; font-size: 14px; }
  .features li { display: grid; grid-template-columns: 28px 1fr; align-items: center; gap: 4px; }
  .f-n { font-family: var(--font-display); text-align: right; padding-right: 6px; }
  .features .tick { justify-self: end; margin-right: 6px; }

  .plan-bottom { margin-top: auto; padding-top: 22px; }
  .saving { font-size: 13px; margin-bottom: 8px; }
  .live { display: flex; align-items: center; gap: 8px; font-size: 13.5px; margin-bottom: 14px; }
  .plan-cta { width: 100%; min-height: 44px; }

  .pricing-note { margin: 28px auto 0; font-size: 13.5px; color: var(--ink-soft); max-width: 1040px; }

  @media (max-width: 1080px) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .plans { grid-template-columns: 1fr; }
    .plan--compact { order: -1; }
  }
</style>
