---
// Cennik — odwzorowanie 1:1 strony „Wybierz plan” z aplikacji (app.huespo.app/pricing).
// Wymiary, kolory i kolejność pozycji jak w src/routes/_authenticated/pricing.tsx w huespo-hq.
import type { Content } from '../../i18n/pl';
import type { Lang } from '../../i18n';
import { PLANS, CURRENCIES, DEFAULT_CURRENCY } from '../../config/pricing';
import { registerUrl } from '../../config/links';

interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const t = c.pricing;
const cur = DEFAULT_CURRENCY[lang];
// Wersja polska ma zawsze złotówki; ES/EN pozwalają wybrać EUR lub GBP.
const lockCurrency = lang === 'pl';
const currencies = lockCurrency ? [cur] : CURRENCIES.filter((cc) => cc !== 'PLN');

const fmt = (n: number) => n.toFixed(2).replace('.', ',');
// Odmiana jak w aplikacji: 1 Obiekt / 4 Obiekty / 10 Obiektów
const count = (forms: { one: string; few: string; many: string }, n: number) => {
  if (n === 1) return forms.one;
  const last = n % 10, lastTwo = n % 100;
  if (last >= 2 && last <= 4 && (lastTwo < 12 || lastTwo > 14)) return forms.few;
  return forms.many;
};
const prices = (i: number) => JSON.stringify(
  Object.fromEntries(CURRENCIES.map((cc) => [cc, { monthly: fmt(PLANS[i].prices[cc].monthly), yearly: fmt(PLANS[i].prices[cc].yearly) }])),
);
---
<section
  class="section pricing"
  id="cennik"
  aria-labelledby="pricing-title"
  data-default-currency={cur}
  data-lock-currency={lockCurrency ? 'true' : undefined}
  data-lang={lang}
>
  <div class="container pricing-inner">
    <div class="pricing-head">
      <h2 id="pricing-title">{t.title}</h2>
      <p class="pricing-sub">{t.sub}</p>
    </div>

    <div class="pricing-controls">
      <div class="toggle" role="group" aria-label={t.cycleLabel}>
        <button type="button" data-cycle="monthly" aria-pressed="true">{t.monthly}</button>
        <button type="button" data-cycle="yearly" aria-pressed="false">{t.yearly}</button>
      </div>
      {currencies.length > 1 && (
        <div class="toggle" role="group" aria-label={t.currencyLabel}>
          {currencies.map((cc) => (
            <button type="button" data-currency={cc} aria-pressed={cc === cur ? 'true' : 'false'}>{cc}</button>
          ))}
        </div>
      )}
    </div>

    <div class="plans">
      {PLANS.map((plan, idx) => {
        const light = plan.id === 'compact' || plan.id === 'pro';
        const checks = [
          plan.qr && t.labels.qr,
          plan.ownLogo && t.labels.ownLogo,
          plan.sorting && t.labels.sorting,
          plan.support24 && t.labels.support24,
        ].filter(Boolean) as string[];
        return (
          <article class:list={['plan', `plan--${plan.id}`, { 'plan--light-text': light }]} id={`plan-${plan.id}`} aria-labelledby={`plan-name-${plan.id}`}>
            <h3 class="plan-name" id={`plan-name-${plan.id}`}>{plan.name}</h3>
            <p class="plan-price price" data-prices={prices(idx)}>
              <span class="cur" data-part="code">{cur}</span><span class="amount" data-part="number">{fmt(plan.prices[cur].monthly)}</span>
            </p>
            <p class="plan-badge">{t.badges[plan.id]}</p>

            <ul class="plan-features" role="list">
              <li>{plan.objects}&nbsp;{count(t.labels.objects, plan.objects)}</li>
              <li>{plan.languages}&nbsp;{count(t.labels.languages, plan.languages)}</li>
              <li>{plan.localRecs}&nbsp;{count(t.labels.localRecs, plan.localRecs)}</li>
              <li class="check"><span class="tick" aria-hidden="true">✓</span><span>{t.labels.liveUpdate}</span></li>
              {checks.map((label) => (
                <li class="check"><span class="tick" aria-hidden="true">✓</span><span>{label}</span></li>
              ))}
            </ul>

            <div class="plan-spacer"></div>

            <a class="plan-cta" href={registerUrl(plan.id, 'monthly', lang)} data-plan={plan.id}>
              {t.cta}<span class="visually-hidden"> {plan.name}</span>
            </a>
          </article>
        );
      })}
    </div>

    <p class="pricing-note">{t.note}</p>
  </div>
</section>

<style>
  /* Kolory z aplikacji */
  .pricing {
    --app-fg: #241a12; --app-muted: #8a7a6b; --app-border: #a6a6a6;
    background: var(--cream);
  }
  .pricing-inner { max-width: 1000px; }
  h2 { font-size: 30px; line-height: 1.2; letter-spacing: -0.025em; color: var(--app-fg); }
  .pricing-sub { margin-top: 8px; font-size: 14px; color: var(--app-muted); }

  .pricing-controls { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0; }
  .toggle { display: inline-flex; border: 1px solid var(--app-border); border-radius: 999px; background: #fff; padding: 4px; font-size: 14px; }
  .toggle button {
    cursor: pointer; border: 0; background: transparent; border-radius: 999px; padding: 6px 16px;
    font-family: var(--font-display); color: var(--app-muted); transition: color .15s, background-color .15s;
  }
  .toggle button:hover { color: var(--app-fg); }
  .toggle button[aria-pressed='true'] { background: #ff721e; color: #fff; }

  .plans { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .plan {
    position: relative; display: flex; flex-direction: column; overflow: hidden;
    border: 1px solid var(--app-border); border-radius: 16px; padding: 16px;
    box-shadow: 0 6px 16px rgba(20, 10, 10, 0.14);
    background: #fff; color: var(--app-muted);
  }
  .plan--compact { background: #ede2df url('../../assets/pricing-compact-bg.jpg') center / cover no-repeat; }
  .plan--pro { background: #ff721e; }

  .plan-name { font-family: var(--font-display); font-size: 19px; font-weight: 400; line-height: 1.3; white-space: nowrap; color: var(--app-fg); letter-spacing: 0; }
  .plan-price {
    margin: 4px 0 8px; text-align: right; white-space: nowrap; font-family: var(--font-display); font-size: 21px; line-height: 1.3;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.22);
  }
  .cur { margin-right: 6px; font-size: 12.75px; color: var(--app-muted); }
  .amount { font-weight: 700; color: #ff721e; }
  .plan-badge {
    margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid rgba(166, 166, 166, 0.6);
    font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; white-space: nowrap;
  }
  .plan-features { list-style: none; margin: 0; padding: 0; font-size: 11px; line-height: 1.5; }
  .plan-features li { margin-bottom: 6px; white-space: nowrap; }
  .plan-features .check { display: flex; align-items: center; gap: 6px; }
  .tick { flex: none; font-size: 12px; font-weight: 700; line-height: 1; color: #ff721e; }
  .plan-spacer { flex: 1; min-height: 12px; }

  .plan-cta {
    display: block; text-align: center; text-decoration: none; cursor: pointer;
    border: 1px solid var(--app-border); border-radius: 9px; padding: 10px 16px;
    font-family: var(--font-display); font-size: 12px; font-weight: 600; line-height: 1.4;
    box-shadow: 0 4px 10px rgba(20, 10, 10, 0.13);
    background: #ff721e; color: #fff; transition: filter .15s;
  }
  .plan-cta:hover { filter: brightness(0.95); }
  .plan--compact .plan-cta { background: #fff; color: var(--app-fg); }
  .plan--pro .plan-cta { background: #ebe2d0; color: var(--app-fg); }

  /* Compact i PRO: biały tekst */
  .plan--light-text, .plan--light-text .plan-name, .plan--light-text .cur, .plan--light-text .amount, .plan--light-text .tick { color: #fff; }
  .plan--light-text .plan-badge { color: rgba(255, 255, 255, 0.85); border-bottom-color: rgba(255, 255, 255, 0.5); }

  .pricing-note { margin-top: 24px; font-size: 13px; color: var(--app-muted); max-width: 60em; }

  @media (max-width: 1023px) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 639px) { .plans { grid-template-columns: 1fr; } }
</style>
