---
import { LANGS, LANG_LABELS, type Lang } from '../i18n';
import type { Content } from '../i18n/pl';
import { LANG_PATHS } from '../config/seo';
import { LINKS } from '../config/links';

interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const home = LANG_PATHS[lang];
---
<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <img src="/logo-wordmark-white.svg" alt="Huespo" width="150" height="41" loading="lazy" />
      <p>{c.footer.description}</p>
    </div>
    <nav class="footer-nav" aria-label={c.nav.mainLabel}>
      <a href={`${home}#jak-to-dziala`}>{c.nav.how}</a>
      <a href={`${home}#funkcje`}>{c.nav.features}</a>
      <a href={`${home}#cennik`}>{c.nav.pricing}</a>
      <a href={`${home}#faq`}>{c.nav.faq}</a>
      <a href={LINKS.login}>{c.nav.login}</a>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>{c.footer.copyright} · {c.footer.company} · {c.footer.location}</p>
    <ul class="footer-links">
      <li><a href={LINKS.terms}>{c.footer.terms}</a></li>
      <li><a href={LINKS.privacy}>{c.footer.privacy}</a></li>
      <li><a href={`mailto:${LINKS.email}`}>{LINKS.email}</a></li>
      {LANGS.length > 1 && LANGS.map((l) => (
        <li><a href={LANG_PATHS[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_LABELS[l]}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: #1d140e; color: rgba(255, 255, 255, 0.82); padding: 48px 0 24px; font-size: 14px; }
  .footer-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 32px; flex-wrap: wrap; }
  .footer-brand img { height: 36px; width: auto; }
  .footer-brand p { margin-top: 12px; max-width: 28em; }
  .footer-nav { display: flex; flex-wrap: wrap; gap: 10px 28px; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--white); text-decoration: underline; }
  .footer-bottom {
    margin-top: 36px; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, 0.15);
    display: flex; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; font-size: 13px; color: rgba(255, 255, 255, 0.7);
  }
  .footer-links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .footer-links a[aria-current='true'] { color: var(--white); }
</style>
