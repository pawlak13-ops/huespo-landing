---
import '@fontsource/sora/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../styles/global.css';
import soraLatin from '@fontsource/sora/files/sora-latin-400-normal.woff2?url';
import interLatin from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANGS, CONTENT, type Lang } from '../i18n';
import type { Content } from '../i18n/pl';
import { SITE_URL, LANG_PATHS, OG_LOCALE, GOOGLE_SITE_VERIFICATION } from '../config/seo';

interface Props {
  c: Content;
  lang: Lang;
  title: string;
  description?: string;
  /** Strony pomocnicze (dziękujemy, 404) nie trafiają do Google. */
  noindex?: boolean;
  /** Ścieżka tej strony, np. '/' albo '/es/'. */
  path: string;
  jsonLd?: object[];
}

const { c, lang, title, description = c.meta.description, noindex = false, path, jsonLd = [] } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL(`/og/og-${lang}.png`, SITE_URL).href;

// Dane dla paska „ta strona jest dostępna w Twoim języku”.
const langOffers = Object.fromEntries(
  LANGS.map((l) => [l, { ...CONTENT[l]!.langOffer, path: LANG_PATHS[l] }]),
);
---
<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {path === '/' && (
      <!-- Pierwsze wejście na huespo.app: otwórz wersję w języku urządzenia
           (a gdy go nie mamy — wg strefy czasowej). Ręczny wybór z przełącznika wygrywa zawsze. -->
      <script is:inline define:vars={{ paths: LANG_PATHS }}>
        (function () {
          try {
            if (/bot|crawl|spider|slurp|lighthouse|preview/i.test(navigator.userAgent)) return;
            var lang = null;
            try { lang = localStorage.getItem('huespo-lang'); } catch (e) {}
            if (!lang || !paths[lang]) {
              lang = null;
              var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
              for (var i = 0; i < list.length && !lang; i++) {
                var code = String(list[i] || '').slice(0, 2).toLowerCase();
                if (paths[code]) lang = code;
              }
              if (!lang) {
                var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
                if (tz === 'Europe/Warsaw') lang = 'pl';
                else if (/^(Europe\/Madrid|Atlantic\/Canary|Africa\/Ceuta)$/.test(tz)) lang = 'es';
                else lang = 'en';
              }
            }
            if (paths[lang] !== '/') location.replace(paths[lang] + location.search + location.hash);
          } catch (e) {}
        })();
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    {!noindex && LANGS.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(LANG_PATHS[l], SITE_URL).href} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL('/', SITE_URL).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Huespo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.meta.ogImageAlt} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/logo-icon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fffcf3" />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-lang={lang}>
    <a class="skip-link" href="#main">{c.nav.skip}</a>
    <div class="lang-offer" id="lang-offer" hidden data-offers={JSON.stringify(langOffers)} data-dismiss={c.langOffer.dismiss}></div>
    <Header c={c} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer c={c} lang={lang} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  .lang-offer {
    position: fixed; left: 50%; transform: translateX(-50%); z-index: 60;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px)); width: max-content; max-width: calc(100% - 32px);
    border-radius: var(--radius-card); box-shadow: var(--shadow-lift);
    background: var(--text-heading); color: var(--white);
    font-size: 14px; padding: 10px 16px;
    display: flex; gap: 12px; justify-content: center; align-items: center; flex-wrap: wrap;
  }
  .lang-offer[hidden] { display: none; }
  .lang-offer a { color: var(--white); font-weight: 500; }
  .lang-offer button {
    background: none; border: 1px solid rgba(255,255,255,.5); color: var(--white);
    border-radius: 100px; padding: 2px 12px; cursor: pointer; font-size: 13px;
  }
</style>
